<div class="main-container">
      <div class="image-row">
        <img class="profile-image" src="images/WebBusinessSelf_square.jpg" alt="Drew Krehel Headshot">
      </div> <!-- /image-row -->

      <div class="name-row">
        Jereme Drew Krehel
      </div> <!-- /name-row -->
        
      <div class="social-icons-row">
        <a href="https://github.com/DrewKrehel" target="_blank"><i class="fa-brands fa-github"></i></a>
        <a href="https://www.linkedin.com/in/drew-krehel-6617bb5b/" target="_blank"><i class="fa-brands fa-linkedin"></i></a>
        <a href="https://www.instagram.com/thedruth78/" target="_blank"><i class="fa-brands fa-instagram"></i></a>
        <a href="https://www.facebook.com/drew.krehel/" target="_blank"><i class="fa-brands fa-facebook"></i></a>

      </div> <!-- /social-icons-row -->

      <div class="links-row">
        <% @list_of_items.each do |the_item| %>
          <div class="link-item">
            <img class="thumbnail_alt1" src="<%= the_item.thumbnail_url %>" alt="Drew Krehel logo">
            <a class="link-text" href="<%= the_item.link_url %>">
              <%= the_item.link_description %>
            </a>
          </div>
        <% end %>
      </div> <!-- /links-row -->

    </div> <!-- /main-container -->

<%= @list_of_items.each do |the_item| %>
  <div>
    <a href="<%= the_item.link_url %>">
      <%= the_item.link_description %>
    </a>
  </div>
<% end %>
